{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  automerge: true,
  schedule: 'on monday',
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 8am on saturday',
    ],
  },
  packageRules: [
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'node',
      ],
      allowedVersions: '< 18.16',
    },
  ],
}
